{
  "name": "aws-ssm-parameter-store-gui",
  "version": "1.0.0",
  "description": "A local web GUI for managing AWS Systems Manager Parameter Store parameters",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.994.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.2",
    "postcss": "8.5.16",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hot-toast": "2.6.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
