{
  "name": "aws-ssm-parameter-store-gui",
  "version": "1.0.0",
  "description": "A local web GUI for managing AWS Systems Manager Parameter Store parameters",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.994.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
